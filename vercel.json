{
    "version": 2,
    "buildCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && export PATH=\"$HOME/.cargo/bin:$PATH\" && uv sync --frozen --no-dev && npm install && npm run build:css",
    "installCommand": "echo 'Using custom buildCommand'",
    "builds": [
        {
            "src": "flask_app.py",
            "use": "@vercel/python",
            "config": {
                "includeFiles": [
                    "templates/**",
                    "static/**",
                    "data/**",
                    "instance/**",
                    "routes/**",
                    "utils/**",
                    "models.py",
                    "extensions.py"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "flask_app.py"
        }
    ]
}