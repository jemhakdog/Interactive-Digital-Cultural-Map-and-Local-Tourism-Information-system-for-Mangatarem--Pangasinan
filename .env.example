# ==============================================================================
# Mangatarem Digital Cultural Mapping & Tourism Platform - Runtime Environment
# ==============================================================================
# Copy this file to `.env` in the project root and provide suitable local values.
# IMPORTANT: Never commit actual secret keys, passwords, or production credentials.

# ------------------------------------------------------------------------------
# Security & Authentication (Mandatory)
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens and JWTs.
# Generate a strong key with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production

# Google OAuth 2.0 Client ID for verifying Google Sign-In id_tokens.
# Matches backend/app/core/config.py default client ID.
GOOGLE_CLIENT_ID=794547070676-80dbt1j3a724hacci5684s7b7v93j1fh.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Full database connection URL override.
# Defaults to local SQLite instance (sqlite:///instance/mangatarem.db) if empty/omitted.
# For local SQLite: sqlite:///instance/mangatarem.db
# For PostgreSQL / Supabase: postgresql://postgres.xxxx:password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///instance/mangatarem.db

# ------------------------------------------------------------------------------
# Application Environment & Runtime
# ------------------------------------------------------------------------------
# Environment mode: development | staging | production | test
# Note: development mode enables SQL query logging and automatic table creation via init_db().
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# JWT Token Signing
# ------------------------------------------------------------------------------
# Algorithm used for JWT encoding/decoding (default: HS256)
ALGORITHM=HS256

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Allowed origins for CORS middleware.
# Expressed as a JSON array string parsed into list[str] by pydantic-settings.
# Include Next.js frontend (http://localhost:3000), Vite dev (http://localhost:5173), etc.
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Optional External API Keys (LLM / Agent tooling)
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=