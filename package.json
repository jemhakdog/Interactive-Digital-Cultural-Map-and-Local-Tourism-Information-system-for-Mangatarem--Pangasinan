{
    "name": "mangatarem-tourism",
    "version": "1.0.0",
    "description": "Interactive Digital Cultural Map and Local Tourism Information system",
    "main": "index.js",
    "scripts": {
        "postinstall": "chmod +x node_modules/.bin/* 2>/dev/null || true",
        "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/main.css --minify",
        "build:js": "node node_modules/terser/bin/terser static/js/map.js -o static/js/map.min.js --config-file terser-config.json",
        "build": "npm run build:css && npm run build:js"
    },
    "devDependencies": {
        "tailwindcss": "^3.4.1",
        "terser": "^5.44.1"
    }
}